# Copia este archivo a  .env  (en esta misma carpeta _docker-demo)
# La DATABASE_URL la pone el docker-compose (apunta al contenedor), no la toques aquí.

SESSION_SECRET=cambia_esto_por_cualquier_texto_largo_min16

# NAS (archivado de documentos) · valores dummy · no se usa fuera de la red de MM
NAS_URL=https://localhost
NAS_USER=demo
NAS_PASS=demo
NAS_TLS_INSECURE=true

# IA · OPCIONAL · solo para leer PDFs (estado de cuenta / contrato) en vivo.
# La data ya cargada y la conciliación de abril FUNCIONAN sin estas keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=

# Frontend · mismo host donde corre la app
VITE_API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
