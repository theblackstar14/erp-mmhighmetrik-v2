{
  "name": "erp-mmhighmetrik",
  "version": "2.0.0",
  "description": "ERP empresarial MM HIGH METRIK ENGINEERS S.A.C. · construcción civil Peru",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/**\" dev",
    "build": "pnpm --filter \"./apps/**\" build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm --recursive typecheck",
    "db:generate": "pnpm --filter @erp/db generate",
    "db:migrate": "pnpm --filter @erp/db migrate",
    "db:studio": "pnpm --filter @erp/db studio",
    "db:seed": "pnpm --filter @erp/db seed",
    "db:verify-f0": "pnpm --filter @erp/db verify-f0",
    "db:import-pg0005-presupuesto": "pnpm --filter @erp/db import-pg0005-presupuesto",
    "db:verify-f1a": "pnpm --filter @erp/db verify-f1a",
    "db:import-pg0005-cronograma": "pnpm --filter @erp/db import-pg0005-cronograma",
    "db:verify-f1b": "pnpm --filter @erp/db verify-f1b",
    "db:import-pg0005-calendario": "pnpm --filter @erp/db import-pg0005-calendario",
    "db:verify-f1c": "pnpm --filter @erp/db verify-f1c",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@biomejs/biome": "^1.9.4",
    "@google/generative-ai": "^0.21.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.3",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0"
}
