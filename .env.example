# Database
DATABASE_URL=postgresql://erp:erp@localhost:5432/erp_mmh

# Backend
PORT=3001
NODE_ENV=development
SESSION_SECRET=cambia_esto_por_un_string_aleatorio_largo_de_32_caracteres_minimo

# NAS Synology (WebDAV)
# LAN: https://192.168.1.200:5006 · remoto: túnel cloudflared contra ese puerto.
# El quick-tunnel de trycloudflare cambia de URL en cada arranque: si el NAS deja de
# alcanzarse, el túnel se reinició y hay que pegar la URL nueva acá y en .env.
NAS_URL=https://compact-arctic-picnic-zen.trycloudflare.com
NAS_USER=Soporte
NAS_PASS=
NAS_ROOT=/Proyectos
# true desactiva la validación de certificados del proceso ENTERO (server.ts:33), no solo
# del NAS. Solo tiene sentido apuntando al Synology por LAN con cert self-signed.
NAS_TLS_INSECURE=false

# Gemini API (parser contratos + análisis IA)
# Obtener en https://aistudio.google.com/apikey · free tier 1500 req/día
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# MPXJ · conversión .mpp → .xml
# Path a tools/mpxj/lib (carpeta con jars descargada de sourceforge.net/projects/mpxj)
# Requiere Java 17+ instalado · https://adoptium.net
MPXJ_LIB_PATH=
JAVA_BIN=java

# Zlink · lector biométrico SenseFP M1 (asistencia)
# El lector solo empuja a la nube ZKBio Zlink; el backend la sondea 09:30 y 10:00 (hora Perú).
# Sin estas tres el sync falla con "Credenciales de Zlink ausentes" (no rompe el backend).
# ZLINK_DEVICE_IDS: UUID interno de cada lector (32 hex), coma-separado. NO es el serial que
# el portal muestra bajo el nombre. Se saca de F12 → Network → POST /dcc/transaction → deviceIds.
ZLINK_USER=
ZLINK_PASS=
ZLINK_DEVICE_IDS=

# Frontend
VITE_API_URL=http://localhost:3001
